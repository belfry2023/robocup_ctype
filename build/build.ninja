  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Stm32project\robocup_ctype\build\cmake\stm32cubemx && D:\CMake\bin\cmake.exe --regenerate-during-build -SD:\Stm32project\robocup_ctype -BD:\Stm32project\robocup_ctype\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build robocup_ctype: phony robocup_ctype.elf

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/Stm32project/robocup_ctype/build

build all: phony robocup_ctype.elf cmake/stm32cubemx/all

# =============================================================================

#############################################
# Folder: D:/Stm32project/robocup_ctype/build/cmake/stm32cubemx

build cmake/stm32cubemx/all: phony

